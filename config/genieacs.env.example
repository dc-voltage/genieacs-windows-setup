# ==============================================================================
# GenieACS Windows Environment Configuration File
# Copy this file to C:\genieacs\genieacs.env
# ==============================================================================

# MongoDB Connection String (Default local MongoDB instance)
GENIEACS_MONGODB_CONNECTION_URL=mongodb://127.0.0.1:27017/genieacs

# Log file paths (Forward slashes are supported and recommended on Windows)
GENIEACS_CWMP_ACCESS_LOG_FILE=C:/genieacs/log/cwmp-access.log
GENIEACS_NBI_ACCESS_LOG_FILE=C:/genieacs/log/nbi-access.log
GENIEACS_FS_ACCESS_LOG_FILE=C:/genieacs/log/fs-access.log
GENIEACS_UI_ACCESS_LOG_FILE=C:/genieacs/log/ui-access.log
GENIEACS_DEBUG_FILE=C:/genieacs/log/debug.log

# Extension scripts directory
GENIEACS_EXT_DIR=C:/genieacs/ext

# JWT secret key for UI sessions (Replace with a random 32+ character string)
GENIEACS_UI_JWT_SECRET=change_this_to_a_random_secure_secret_key_1234567890

# Port overrides (Uncomment if default ports conflict)
# GENIEACS_CWMP_PORT=7547
# GENIEACS_NBI_PORT=7557
# GENIEACS_FS_PORT=7567
# GENIEACS_UI_PORT=3000
